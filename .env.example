# Copy to .env and fill in. Never commit .env.

# Supabase → Connect → Transaction pooler (port 6543), with your database password filled in.
DATABASE_URL=

# Gmail SMTP: your Gmail address and a 16-character App Password
# (https://myaccount.google.com/apppasswords). Leave empty to skip email; messages are still saved.
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=arsen.harutyunyan088@gmail.com

# Any long random string. Used to hash visitor IPs for rate limiting.
IP_HASH_SALT=
